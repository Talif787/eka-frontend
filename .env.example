# Two ways to reach the backend, pick one.
#
# A) Different Codespaces (or any separate host): the browser calls the backend
#    directly. Set this to the backend's forwarded URL. The backend must have
#    CORS enabled and its port set to Public.
NEXT_PUBLIC_API_BASE_URL=https://your-backend-8000.app.github.dev
#
# B) Same Codespace: leave NEXT_PUBLIC_API_BASE_URL unset and the app uses the
#    same-origin Next proxy, which forwards to API_BASE_URL over loopback.
# API_BASE_URL=http://127.0.0.1:8000
